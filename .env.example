# Copy to .env for docker compose, and keep it private: chmod 600 .env
# A long random password, e.g. from: openssl rand -hex 24
POSTGRES_PASSWORD=

# Where the file server listens. The default only accepts connections from
# this machine, e.g. from a TLS-terminating reverse proxy; 0.0.0.0 accepts
# them from everywhere, which sends passwords unencrypted.
GOFTP_BIND=127.0.0.1
GOFTP_PORT=8080

# Behind a reverse proxy: the header carrying the client address and the
# address the proxy's requests come from (see "ip" in goftp's access log).
# Use X-Forwarded-For: common proxies append to it, so clients cannot forge
# it. The proxy should also send X-Forwarded-Proto. Then client addresses
# are rate limited separately and HTTPS is recognized.
GOFTP_PROXY_HEADER=
GOFTP_TRUSTED_PROXIES=

# Or serve HTTPS directly, with GOFTP_BIND=0.0.0.0: the directory holding
# the certificate chain and its key (readable by GOFTP_RUN_AS), and their
# names in it, e.g. /etc/goftp/tls, fullchain.pem and privkey.pem.
GOFTP_TLS_DIR=
GOFTP_TLS_CERT=
GOFTP_TLS_KEY=

# Directory to serve, as an absolute path such as a disk mounted at
# /mnt/storage/shared. Empty: the "files" Docker volume.
GOFTP_DATA=
# uid:gid the server runs as. For uploads into GOFTP_DATA, use the owner of
# that directory, e.g. 1000:1000 (see `id`). Empty: 65532:65532.
GOFTP_RUN_AS=

# Largest accepted upload per file, e.g. 10GiB; 0 = unlimited.
GOFTP_UPLOAD_MAX_SIZE=0
# Free disk space that uploads leave for the database and everything else
# on the disk, e.g. 5GiB; 0 = no check.
GOFTP_UPLOAD_MIN_FREE=1GiB

# How much each user's home may hold, along with what they deleted from it
# that is in the trash, e.g. 10GiB; 0 = no limit. `goftp user quota NAME
# SIZE` sets it for one user.
GOFTP_HOMES_QUOTA=0

# Connections one client may hold at once when clients connect directly,
# e.g. 100; 0 = no limit. Behind a reverse proxy, limit them there.
GOFTP_MAX_CONNS_PER_IP=0
